<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Framelet</AssemblyName>
    <RootNamespace>Framelet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Framelet.ico</ApplicationIcon>
    <Product>帧简 Framelet</Product>
    <Version>0.5.0</Version>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/Framelet</PathMap>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <Description>Framelet — capture, annotate and share everyday moments</Description>
  </PropertyGroup>
</Project>
